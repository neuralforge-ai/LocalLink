<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        style="@style/LocalLink.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/forgot_title" />

    <TextView
        style="@style/LocalLink.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/forgot_subtitle" />

    <EditText
        android:id="@+id/etEmail"
        style="@style/LocalLink.Input"
        android:layout_marginTop="28dp"
        android:hint="@string/hint_email"
        android:imeOptions="actionDone"
        android:inputType="textEmailAddress" />

    <Button
        android:id="@+id/btnSendReset"
        style="@style/LocalLink.Button"
        android:text="@string/btn_send_reset" />

    <TextView
        style="@style/LocalLink.Link"
        android:onClick="goToLogin"
        android:text="@string/link_back_login" />
</LinearLayout>